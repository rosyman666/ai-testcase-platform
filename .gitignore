# ---------- Java / Maven ----------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.jar
*.war
*.log
hs_err_pid*
replay_pid*

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 环境变量与密钥（AI Key 绝不能进仓库）----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- 数据库与运行时数据 ----------
# 凡由配置项指向的写盘目录，都必须在此登记（见 docs/01-architecture.md §8.8 ③ 第 ④ 步）。
# 判据：跑一次上传 + 一次导出后 `git status --short` 只应显示源码改动。
*.sql.bak
data/
# STORAGE_DIR 默认值：原始上传文件落盘根目录
uploads/
# EXPORT_TEMP_DIR 默认值：JUnit zip 等导出产物
exports/
logs/

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
*.code-workspace

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 测试与覆盖率 ----------
coverage/
.nyc_output/
