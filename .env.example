# 模型接入配置
# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 忽略，绝不要提交。
# 默认 provider 为 mock：无需任何 Key 即可跑通全链路（离线可演示、CI 友好）。

# 可选值：mock | openai-compatible
AI_PROVIDER=mock

# 以下仅在 AI_PROVIDER=openai-compatible 时生效
# DeepSeek:  https://api.deepseek.com
# 通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 vLLM: http://127.0.0.1:8000/v1
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# 调用参数
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE_TESTPOINT=0.2
AI_TEMPERATURE_GENERATE=0.4
AI_TEMPERATURE_REPAIR=0.0
