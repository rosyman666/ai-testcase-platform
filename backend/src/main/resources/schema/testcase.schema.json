{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "classpath:schema/testcase.schema.json",
  "title": "测试用例生成结果",
  "description": "校验的是【数组】本身，与 testpoint.schema.json 一致（失败路径形如 [2].priority）。",
  "type": "array",
  "minItems": 1,
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "precondition", "steps", "expected", "priority", "caseType"],
    "properties": {
      "title": {
        "type": "string",
        "minLength": 4,
        "maxLength": 200,
        "description": "用例标题：动作 + 对象 + 预期，例如「缺少必填字段 name 时创建用户返回 40001」。"
      },
      "precondition": {
        "type": "string",
        "maxLength": 500,
        "description": "前置条件；没有则写「无」。空串也算合法，但显式写「无」比空白更好读。"
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "description": "可执行步骤，一步一件事。合并成一句会导致执行时无法定位失败在第几步。",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "expected": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "description": "可判定的预期结果，必须包含可观察量（状态码/字段值/副作用），禁止写「正常」「符合预期」这类无法判定的词。"
      },
      "priority": {
        "type": "string",
        "enum": ["P0", "P1", "P2", "P3"],
        "description": "必须与 common/enums/CasePriority 一致。写成「高」「中」会 E_SCHEMA_INVALID。"
      },
      "caseType": {
        "type": "string",
        "enum": ["FUNCTIONAL", "BOUNDARY", "EXCEPTION", "SECURITY", "PERFORMANCE", "COMPATIBILITY"],
        "description": "必须与 common/enums/CaseType 一致。"
      }
    }
  }
}
